# ── LLM ───────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Threat Intel Search (Phase 2) ─────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── Notifications (Phase 3) ───────────────────────────
# Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here
#OR
# Slack: api.slack.com → Your Apps → Incoming Webhooks → Add New Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your_webhook_here

# ── Tracing (Phase 3) ─────────────────────────────────
NOVEUM_API_KEY=your_noveum_key_here
OMIUM_API_KEY=your_omium_key_here

# ── App settings ──────────────────────────────────────
APP_ENV=development
LOG_LEVEL=DEBUG
